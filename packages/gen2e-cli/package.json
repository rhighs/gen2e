{
  "name": "@rhighs/gen2e-cli",
  "version": "1.1.10",
  "description": "Compile plain English instruction files to Playwright specs",
  "files": [
    "dist",
    "bin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhighs/gen2e.git",
    "directory": "packages/gen2e-cli"
  },
  "homepage": "https://github.com/rhighs/gen2e/tree/master/packages/gen2e-cli#readme",
  "bugs": "https://github.com/rhighs/gen2e/issues",
  "main": "dist/src/index.js",
  "bin": {
    "gen2e-cli": "bin/gen2e-cli.js"
  },
  "dependencies": {
    "@playwright/test": "^1.44.0",
    "@rhighs/gen2e": "workspace:^",
    "@rhighs/gen2e-interpreter": "workspace:^",
    "@rhighs/gen2e-llm": "workspace:^",
    "@rhighs/gen2e-logger": "workspace:^",
    "@rhighs/gen2e-po": "workspace:^",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "start": "bun ./src/index.ts",
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "release": "bun publish --access public --tolerate-republish",
    "test": "bun test --isolate --preload ../../test-setup.ts tests/unit"
  },
  "keywords": [
    "ai",
    "test",
    "llm",
    "playwright",
    "e2e"
  ],
  "author": "Roberto Montalti",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12"
  }
}
