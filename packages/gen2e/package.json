{
  "name": "@rhighs/gen2e",
  "version": "1.2.6",
  "description": "A playwright assistant library, write e2e tests as plain english instructions",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhighs/gen2e.git",
    "directory": "packages/gen2e"
  },
  "homepage": "https://github.com/rhighs/gen2e/tree/main/packages/gen2e#readme",
  "bugs": "https://github.com/rhighs/gen2e/issues",
  "dependencies": {
    "@rhighs/gen2e-core": "workspace:^",
    "@rhighs/gen2e-llm": "workspace:^",
    "@rhighs/gen2e-logger": "workspace:^",
    "@rhighs/gen2e-store": "workspace:^",
    "ai": "^7.0.163",
    "sanitize-html": "^2.11.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ai-sdk/provider": "4.0.36",
    "@hono/node-server": "^2.1.6",
    "@playwright/test": "^1.39.0",
    "@types/sanitize-html": "^2.9.4",
    "hono": "^4.13.16"
  },
  "scripts": {
    "test-server": "bun ./tests/bin/start-test-server.ts",
    "test": "bun test --isolate --preload ../../test-setup.ts tests/unit",
    "test:e2e": "bun --bun playwright test tests/e2e/test-gen.spec.ts",
    "typecheck": "tsc --noEmit",
    "test:e2e:scripted": "bun --bun playwright test tests/e2e/scripted.spec.ts tests/e2e/dom-revision.spec.ts tests/e2e/corpus.spec.ts",
    "release": "bun publish --access public --tolerate-republish"
  },
  "keywords": [
    "ai",
    "test",
    "llm",
    "playwright",
    "e2e"
  ],
  "author": "Roberto Montalti",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
