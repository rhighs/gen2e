{
  "name": "@rhighs/gen2e-interpreter",
  "version": "1.1.9",
  "description": "A library exposing an LLM based interpreter, provide it human browser instructions and get generated playwright tests back",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhighs/gen2e.git",
    "directory": "packages/gen2e-interpreter"
  },
  "homepage": "https://github.com/rhighs/gen2e/tree/main/packages/gen2e-interpreter#readme",
  "bugs": "https://github.com/rhighs/gen2e/issues",
  "main": "dist/index.js",
  "dependencies": {
    "@babel/parser": "^7.29.13",
    "@playwright/test": "^1.44.0",
    "@rhighs/gen2e": "workspace:^",
    "@rhighs/gen2e-core": "workspace:^",
    "@rhighs/gen2e-llm": "workspace:^",
    "@rhighs/gen2e-logger": "workspace:^",
    "@rhighs/gen2e-store": "workspace:^",
    "ast-types": "^0.16.3",
    "jscodeshift": "^17.4.0"
  },
  "devDependencies": {
    "@types/jscodeshift": "^17.3.0",
    "@types/node": "^22.20.5",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build": "rm -rf dist && tsc --project tsconfig.build.json",
    "test": "bun test --isolate --preload ../../test-setup.ts tests/unit",
    "typecheck": "tsc --noEmit",
    "release": "bun publish --access public --tolerate-republish"
  },
  "keywords": [
    "ai",
    "test",
    "llm",
    "playwright",
    "e2e"
  ],
  "author": "Roberto Montalti",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12"
  }
}
