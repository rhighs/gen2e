{
  "name": "gen2e",
  "version": "1.0.0",
  "description": "Write Playwright tests in plain English",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "typecheck": "tsc -p . && bun run --filter './packages/*' typecheck",
    "test": "bun run --filter './packages/*' test",
    "test:integration": "bun run --filter './packages/gen2e-llm' test:integration",
    "test:e2e": "bun run --filter './packages/gen2e' test:e2e",
    "eval": "bun packages/gen2e/tests/evals/run.ts",
    "eval:replay": "bun packages/gen2e/tests/evals/run.ts --replay",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "gate": "bun run check && bun run typecheck && bun run test && bun run test:e2e:scripted",
    "release": "bun run gate && bun run --filter './packages/*' release",
    "test:e2e:scripted": "bun run --filter ./packages/gen2e test:e2e:scripted"
  },
  "keywords": [
    "ai",
    "playwright",
    "e2e",
    "testing",
    "llm"
  ],
  "author": "Roberto Montalti",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@types/bun": "1.4.4",
    "typescript": "6.0.3"
  },
  "packageManager": "bun@1.4.4",
  "type": "module"
}
