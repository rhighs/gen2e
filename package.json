{
  "name": "gen2e",
  "version": "1.0.0",
  "description": "Write Playwright tests in plain English",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "lerna run build",
    "publish": "lerna run build && lerna publish",
    "start": "tsx ./packages/gen2e-cli/src/index.ts",
    "test": "lerna run test",
    "test:integration": "lerna run test:integration",
    "eval": "tsx packages/gen2e/tests/evals/run.ts",
    "eval:replay": "tsx packages/gen2e/tests/evals/run.ts --replay",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "optionalDependencies": {
    "@nx/nx-darwin-arm64": "18.0.4",
    "@nx/nx-darwin-x64": "18.0.4",
    "@nx/nx-linux-x64-gnu": "18.0.4",
    "@nx/nx-win32-x64-msvc": "18.0.4"
  },
  "keywords": [
    "ai",
    "playwright",
    "e2e",
    "testing",
    "llm"
  ],
  "author": "Roberto Montalti",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "lerna": "^8.1.3"
  }
}
